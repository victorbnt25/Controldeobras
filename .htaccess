# SPA Routing - Redirigir todas las peticiones a index.html
# para que React Router maneje las rutas
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Si el archivo o directorio solicitado existe físicamente, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # De lo contrario, enviar todo a index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes

# Página de error por defecto (fallback por si acaso)
ErrorDocument 404 /index.html
